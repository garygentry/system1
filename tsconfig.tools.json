{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "tools/**/*.ts",
    "vitest.config.ts",
    "vitest.live.config.ts",
    "packages/*/src/**/*.test.ts",
    "packages/*/src/testdata/**/*.ts"
  ],
  "exclude": ["tools/smoke/fixture-repo", "tools/evals/fixture-repo", "tools/evals/fixture-changes"]
}
