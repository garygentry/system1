{
  "name": "@garygentry/system1-core",
  "version": "0.1.0",
  "description": "Engine for decision-model calls: model profiles, transport, sources, fixtures, spend.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": {
    "name": "Gary Gentry",
    "email": "gary@garygentry.net"
  },
  "homepage": "https://github.com/garygentry/system1",
  "keywords": [
    "decisions",
    "decision-model",
    "jev",
    "classification",
    "triage",
    "agents",
    "library"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/garygentry/system1",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "node ../../tools/prepublish-check.mjs"
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17",
    "typebox": "^1.3.34",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
