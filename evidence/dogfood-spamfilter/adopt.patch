+            with open(file, encoding="utf-8") as f:
+                self.assertEqual(json.loads(f.read().split("\n")[1])["id"], "t1")
+
+    def test_one_row_per_input_unknown_cost_and_a_warning(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            file = os.path.join(tmp, "captured.jsonl")
+            warnings: list[str] = []
+            broken = "x"
+
+            def current(text: str) -> CurrentRun:
+                if text == broken:
+                    raise RuntimeError("the existing mechanism failed")
+                if text == PLUG:
+                    return CurrentRun(True, {"cost": 0.0004})
+                return CurrentRun(False)
+
+            samples = [("t1", PLUG), ("t2", NEVER_RECORDED), ("t3", broken)]
+            summary = capture_shadow(samples, current, file=file, warn=warnings.append)
+            self.assertEqual(summary.written, 2)
+            self.assertEqual([i for i, _ in summary.failed], ["t3"])
+            self.assertIn("raw inputs", "\n".join(warnings))
+            with open(file, encoding="utf-8") as f:
+                rows = [json.loads(line) for line in f]
+            self.assertEqual(rows[0]["current"], {"spam": 1})
+            self.assertEqual(rows[0]["state"], policy.to_state(PLUG))
+            self.assertEqual(rows[0]["usage"], {"cost": 0.0004})
+            self.assertNotIn("usage", rows[1])
+            self.assertIsInstance(rows[1]["latencyMs"], int)
+
+            odd = capture_shadow(
+                [("u1", PLUG), ("u2", PLUG)],
+                lambda _t: CurrentRun(EXISTING, {"cost": float("nan"), "input_tokens": 3}),
+                file=file,
+                warn=lambda _m: None,
+            )
+            self.assertEqual(odd.written, 2)
+
+            bad = capture_shadow(
+                [(5, PLUG), ("  ", PLUG)], current, file=file, warn=lambda _m: None  # type: ignore[list-item]
+            )
+            self.assertEqual([i for i, _ in bad.failed], ["5", "  "])
+
+            again = capture_shadow(samples[:1], lambda _t: CurrentRun(EXISTING), file=file, warn=lambda _m: None)
+            self.assertEqual(again.skipped, ["t1"])
