index 0000000..a23c2d8
--- /dev/null
+++ b/system1/test_policy.py
@@ -0,0 +1,344 @@
+"""Offline tests for the `spam` policy module, generated by system1
+`adopt`. They answer from the spec's recorded fixtures (replay) through
+`decide runtime --replay`: nothing is sent, and no key or grant is needed, but
+`decide` must be on PATH, as it must be wherever the module runs.
+
+Run from the repo root: `python -m pytest system1` (or `python -m unittest
+discover system1`). `DECIDE_CMD` names another `decide` for the tests, e.g.
+`node /path/to/decide.mjs`. Record fresh fixtures with `decide spec check spam
+--live` after changing the questions or the states below; the states here are
+the spec's examples, so their recorded answers are what replay serves.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shlex
+import shutil
+import stat
+import sys
+import tempfile
+import unittest
+from typing import Any
+
+import policy
+from filter import System1Spam
+from grants import grant_problems
+from mapping import to_answer_space
+from policy import EGRESS, QUESTIONS, PolicyOptions, is_spam
+from shadow import CurrentRun, capture_shadow
+from spamfilter.filters.filter import Filter
+
+if os.environ.get("DECIDE_CMD"):
+    policy.DECIDE = shlex.split(os.environ["DECIDE_CMD"])
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+#: The repo's `.system1` directory, which holds `fixtures/spam/`.
+SYSTEM1_DIR = os.path.join(HERE, "..", ".system1")
+#: The module files `adopt` wrote, checked for a grant below.
+MODULE_FILES = [
+    os.path.join(HERE, name)
+    for name in ("policy.py", "mapping.py", "shadow.py", "grants.py", "filter.py", "capture.py", "test_policy.py")
+]
+#: The comment on the one grant line, assembled so this file carries none.
+MARKER = "".join(["system1", ": runtime ", "egr", "ess"])
+
+# The spec's examples, verbatim: their answers are recorded.
+PLUG = "Hey everyone, check out my channel, I make covers of this song!! Subscribe pls"
+REACTION = "This song never gets old, still listening in 2015"
+LIKE_BAIT = "Like this comment if you are watching in 2014!"
+NEVER_RECORDED = "No fixture holds this comment."
+
+#: What the stand-in existing filter says: not spam.
+EXISTING = False
+
+#: Tests that run in live mode are skipped once EGRESS is on, so a test never sends.
+LIVE_SKIP = EGRESS != "off"
+
+
+def existing(_text: str) -> bool:
+    return EXISTING
+
+
+def answered(spam: float) -> PolicyOptions:
+    def engine(_request: dict[str, Any], _options: PolicyOptions) -> dict[str, Any]:
+        return {
+            "ok": True,
+            "source": "replay",
+            "answers": {"spam": {"type": "noul", "noul": spam}},
+            "usage": {"input_tokens": 0, "output_tokens": 0, "cost": 0},
+            "latencyMs": 1,
+            "ledger": "memory",
+        }
+
+    return PolicyOptions(enabled=True, replay=True, engine=engine)
+
+
+class FallsBack(unittest.TestCase):
+    def assert_fell_back(self, outcome: policy.Outcome, reason: str) -> None:
+        self.assertEqual(outcome.by, "existing", outcome)
+        self.assertEqual(outcome.value, EXISTING)
+        self.assertEqual(outcome.reason, reason, outcome.detail)
+
+
+class RuntimeEgress(unittest.TestCase):
+    # When you switch EGRESS on, change this expectation in the same reviewed edit.
+    def test_is_off_as_generated(self) -> None:
+        self.assertEqual(EGRESS, "off")
+
+    def test_no_grant_in_the_module_source(self) -> None:
+        with open(MODULE_FILES[0], encoding="utf-8") as f:
+            self.assertEqual(sum(MARKER in line for line in f), 1)
+        for path in MODULE_FILES:
+            with open(path, encoding="utf-8") as f:
+                self.assertEqual(grant_problems(f.read()), [], path)
+
+    def test_catches_the_grants_it_scans_for(self) -> None:
+        # Assembled, so this file holds none of them.
+        big, small = "EG" + "RESS", "egr" + "ess"
+        for bad in [
+            f'{big}: Final = "o{"n"}"  # system1: runtime {small}',
+            f"{big} = 'o{'n'}'",
+            f"{big}=process.env.X",
+            f'{big} = "off"',
+            f'{big}: Final = "off" and "on"  # system1: runtime {small}',
+            f'SEND = os.environ.get("X") == "1"\nrun({small}={big} if not SEND else "on")',
+            f"from settings import {big}  # system1: runtime {small}",
+            f"{big}, other = load()",
+            f'o["{small}"] = "on"',
+            f'options.{small} = "on"',
+            f'{big}: Final = os.environ.get("X", "off")',
+            f"{small}: true,",
+            f"{small}=grant",
+            f"{small}Consent: true",
+            f'g = os.environ["{big}"]',
+            f"# system1: runtime {small}\n# system1: runtime {small}",
+        ]:
+            self.assertNotEqual(grant_problems(bad), [], bad)
+
+
+class Inert(FallsBack):
+    def test_existing_path_when_not_enabled(self) -> None:
+        calls = []
+        outcome = is_spam(PLUG, lambda t: calls.append(t) or EXISTING)
+        self.assert_fell_back(outcome, "disabled")
+        self.assertEqual(len(calls), 1)
+
+    @unittest.skipIf(LIVE_SKIP, "EGRESS is on: this test would send")
+    def test_existing_path_when_enabled_but_egress_off(self) -> None:
+        self.assert_fell_back(is_spam(PLUG, existing, PolicyOptions(enabled=True)), "egress-off")
+
+
+class Replay(FallsBack):
+    """Answers from the recorded fixtures, through `decide runtime --replay`."""
+
+    def setUp(self) -> None:
+        policy._protocol_checked = None
+        self.replay = PolicyOptions(enabled=True, replay=True, root=SYSTEM1_DIR)
+
+    def test_acts_on_an_answer_that_clears_the_thresholds(self) -> None:
+        outcome = is_spam(PLUG, existing, self.replay)
+        self.assertEqual(outcome.by, "model", outcome)
+        self.assertIs(outcome.value, True)
+        quiet = is_spam(REACTION, lambda _t: True, self.replay)
+        self.assertEqual((quiet.by, quiet.value), ("model", False))
+
+    def test_keeps_the_existing_answer_when_undecided(self) -> None:
+        # Recorded at 0.50: the runtime reports it undecided before the bars apply.
+        self.assert_fell_back(is_spam(LIKE_BAIT, existing, self.replay), "undecided")
+
+    def test_provider_error_when_nothing_is_recorded(self) -> None:
+        self.assert_fell_back(is_spam(NEVER_RECORDED, existing, self.replay), "provider-error")
+
+    def test_refused_when_the_state_is_too_large(self) -> None:
+        self.assert_fell_back(is_spam("word " * 40_000, existing, self.replay), "refused")
+
+    def test_engine_unavailable_without_decide(self) -> None:
+        saved = policy.DECIDE
+        policy.DECIDE = [os.path.join(HERE, "no-such-decide")]
+        try:
+            self.assert_fell_back(is_spam(PLUG, existing, self.replay), "engine-unavailable")
+        finally:
+            policy.DECIDE = saved
+            policy._protocol_checked = None
+
+    def test_a_transient_protocol_failure_is_tried_again(self) -> None:
+        saved = policy.DECIDE
+        policy.DECIDE = [sys.executable, "-c", "pass"]  # prints nothing, as a failed start would
+        try:
+            self.assert_fell_back(is_spam(PLUG, existing, self.replay), "engine-unavailable")
+        finally:
+            policy.DECIDE = saved
+        self.assertEqual(is_spam(PLUG, existing, self.replay).by, "model")
+
+    def test_a_decide_without_runtime_is_settled_once(self) -> None:
+        saved = policy.DECIDE
+        old = 'print(\'{"v": 1, "ok": false}\'); raise SystemExit(2)'
+        policy.DECIDE = [sys.executable, "-c", old]
+        try:
+            outcome = is_spam(PLUG, existing, self.replay)
+            self.assert_fell_back(outcome, "engine-unavailable")
+            self.assertIn("upgrade", outcome.detail)
+        finally:
+            policy.DECIDE = saved
+        # Settled for the process: the real `decide` isn't asked again.
+        self.assert_fell_back(is_spam(PLUG, existing, self.replay), "engine-unavailable")
+
+    @unittest.skipIf(LIVE_SKIP, "EGRESS is on: this test would send")
+    def test_no_git_and_a_read_only_root(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            root = os.path.join(tmp, "system1")
+            shutil.copytree(os.path.join(SYSTEM1_DIR, "fixtures"), os.path.join(root, "fixtures"))
+            for here, dirs, files in os.walk(root, topdown=False):
+                for name in files:
+                    os.chmod(os.path.join(here, name), stat.S_IRUSR)
+                os.chmod(here, stat.S_IRUSR | stat.S_IXUSR)
+            cwd = os.getcwd()
+            os.chdir(tmp)
+            try:
+                answered_ = is_spam(PLUG, existing, PolicyOptions(enabled=True, replay=True, root=root))
+                self.assertEqual(answered_.by, "model", answered_)
+                live = is_spam(PLUG, existing, PolicyOptions(enabled=True, root=root))
+                self.assert_fell_back(live, "egress-off")
+            finally:
+                os.chdir(cwd)
+                for here, dirs, files in os.walk(root):
+                    os.chmod(here, stat.S_IRWXU)
+                    for name in files:
+                        os.chmod(os.path.join(here, name), stat.S_IRUSR | stat.S_IWUSR)
+
+
+class Thresholds(FallsBack):
+    def test_falls_back_when_undecided(self) -> None:
+        def engine(_r: dict[str, Any], _o: PolicyOptions) -> dict[str, Any]:
+            return {"ok": False, "reason": "undecided", "detail": "undecided: spam", "ledger": "memory"}
+
+        options = PolicyOptions(enabled=True, replay=True, engine=engine)
+        self.assert_fell_back(is_spam(PLUG, existing, options), "undecided")
+
+    def test_falls_back_between_the_bars(self) -> None:
+        self.assert_fell_back(is_spam(PLUG, existing, answered(0.62)), "below-threshold")
+
+    def test_acts_at_the_bars_and_traces_each_branch(self) -> None:
+        yes = is_spam(PLUG, existing, answered(0.7))
+        self.assertEqual((yes.by, yes.value), ("model", True))
+        no = is_spam(PLUG, lambda _t: True, answered(0.3))
+        self.assertEqual((no.by, no.value), ("model", False))
+        self.assertEqual([step.split(":")[0] for step in yes.trace], ["model", "spam"])
+
+    def test_answers_of_the_wrong_shape_are_below_the_bar(self) -> None:
+        self.assertIsNone(policy.from_answers({}))
+        self.assertIsNone(policy.from_answers({"spam": {"type": "noul", "noul": True}}))
+
+
+class Spec(unittest.TestCase):
+    def test_has_the_module_questions_verbatim(self) -> None:
+        import yaml  # only the tests read the spec
+
+        with open(os.path.join(SYSTEM1_DIR, "specs", "spam.yaml"), encoding="utf-8") as f:
+            # BaseLoader: YAML 1.1 would read the `true:` key as a boolean.
+            self.assertEqual(yaml.load(f, Loader=yaml.BaseLoader)["questions"], QUESTIONS)
+
+
+class Mapping(unittest.TestCase):
+    def test_maps_every_output_into_the_answer_space(self) -> None:
+        self.assertEqual(to_answer_space(True), {"spam": 1})
+        self.assertEqual(to_answer_space(False), {"spam": 0})
+
+    def test_refuses_a_value_the_question_set_does_not_offer(self) -> None:
+        for bad in ("yes", 1, None):
+            with self.assertRaises(ValueError):
+                to_answer_space(bad)  # type: ignore[arg-type]
+
+
+class Wired(unittest.TestCase):
+    """The filter wired in: unchanged behaviour while it is off."""
+
+    class Marks(Filter):
+        def check(self, string: str) -> "tuple[bool, str]":
+            return ("buy" not in string, string.upper())
+
+    def test_is_the_existing_filter_while_off(self) -> None:
+        f = System1Spam(self.Marks())
+        for text in ("buy now", "nice song"):
+            self.assertEqual(f.check(text), self.Marks().check(text))
+            self.assertEqual(f.last.reason, "disabled")
+
+    def test_refuses_a_correcting_filter(self) -> None:
+        correcting = self.Marks()
+        correcting.mode = "correcting"
+        with self.assertRaises(ValueError):
+            System1Spam(correcting)
+
+    def test_concurrent_checks_keep_their_own_string(self) -> None:
+        from concurrent.futures import ThreadPoolExecutor
+
+        f = System1Spam(self.Marks())
+        texts = [f"comment {i}" for i in range(200)]
+        with ThreadPoolExecutor(8) as pool:
+            results = list(pool.map(f.check, texts))
+        self.assertEqual(results, [(True, text.upper()) for text in texts])
+
