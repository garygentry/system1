@@ -0,0 +1,52 @@
+"""The `spam` policy wired in as a spamfilter filter, generated by system1
+`adopt`. It wraps the filter it would replace (the OpenAI filter) and is inert:
+with `enabled=False`, the default, every check is the wrapped filter's own.
+
+    from spamfilter.filters import OpenAI
+    from filter import System1Spam
+    f = System1Spam(OpenAI("openai/gpt-4o-mini", base_url=..., api_key=...),
+                    enabled=False, root=".system1")
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+from policy import Outcome, PolicyOptions, is_spam
+from spamfilter.filters.filter import Filter
+
+
+class System1Spam(Filter):
+    """Checks a string with the decision model, and falls back to `existing`
+    (any spamfilter filter) whenever the policy can't act. The policy answers
+    spam or not, so it never corrects a string: it refuses a filter in
+    "correcting" mode, whose corrected text it would drop."""
+
+    def __init__(
+        self,
+        existing: Filter,
+        enabled: bool = False,
+        root: Optional[str] = None,
+        timeout_ms: int = 5000,
+    ) -> None:
+        if getattr(existing, "mode", None) == "correcting":
+            raise ValueError("the spam policy can't stand in for a filter in correcting mode")
+        super().__init__(getattr(existing, "mode", "normal"))
+        self.existing = existing
+        #: Where the spend ledger lives, so the daily cap holds across restarts.
+        self.options = PolicyOptions(enabled=enabled, root=root, timeout_ms=timeout_ms)
+        #: The last outcome, for a log line.
+        self.last: Optional[Outcome] = None
+
+    def check(self, string: str) -> "tuple[bool, str]":
+        # The existing filter's string, kept per call, so concurrent checks
+        # on one shared filter never swap each other's text.
+        returned = [string]
+
+        def existing_is_spam(text: str) -> bool:
+            passed, returned[0] = self.existing.check(text)
+            return not passed
+
+        outcome = is_spam(string, existing_is_spam, self.options)
+        self.last = outcome
+        return (not outcome.value, returned[0] if outcome.by == "existing" else string)
diff --git a/system1/grants.py b/system1/grants.py
new file mode 100644
index 0000000..630cef4
--- /dev/null
+++ b/system1/grants.py
@@ -0,0 +1,266 @@
+"""The grant scan for this module's tests, generated by system1 `adopt`: the
+Python copy of the scan `pnpm validate` runs over adopt's templates (0020).
+
+`adopt` only ever writes the marked line set to "off"; turning it on is the
+user's edit. This is an allowlist for the name, read one line at a time:
+- the marked line is a `const` (TS) or `Final` (Python) set to "off";
+- every other use of the name in code is a comparison, an import, an
+  assertion, a read, or the runtime's option given exactly the name, as the
+  last property of the runtime call's object literal, which also names this
+  file (`module: import.meta.url`, so the runtime reads the marked line too),
+  in the file that declares it;
+- a Unicode line separator, or a backslash-u escape in TS code, is refused;
+- `--module` is this file, so `decide runtime` reads this file's marked line.
+
+Comments, docstrings and string contents are skipped. It reads text, not what
+runs, so the user's review of the diff is the control. `decide runtime` also
+reads the marked line from the module file, so both must say on. The words are
+assembled so this file carries no grant of its own.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Optional
+
+E, e = "EG" + "RESS", "egr" + "ess"
+MARKER = "".join(["system1", ": runtime ", e])
+CREATE = "createPolicy" + "Runtime"
+A = re.ASCII
+
+_SEPARATOR = re.compile("[\u2028\u2029]")
+_LINE_END = re.compile("\r\n|[\r\n\u2028\u2029]")
+_OFF_LINE = re.compile(
+    r"^(?:(?:export\s+)?const\s+" + E
+    + r"""\s*(?::\s*[\w.[\]|,"' ]+?\s*)?=\s*(["'])off\1\s*(?:(?:as|satisfies)\s+[\w.]+\s*)?;?\s*//|"""
+    + E
+    + r"""\s*:\s*(?:typing\.)?Final(?:\[[\w.[\]|,"' ]+\])?\s*=\s*(["'])off\2\s*#)\s*"""
+    + MARKER,
+    A,
+)
+_NAME = re.compile(r"\b" + E + r"\b", A)
+_WORD = re.compile(r"\b" + e + r"\b(?!-)", A)
+_ONE_LINE_IMPORT = re.compile(
+    r"^\s*(?:import\s*(?:type\s*)?\{[^}]*\}\s*from\s|from\s+[\w.]+\s+import\s+[\w\s,]*$)", A
+)
+_GIVEN_BEFORE = re.compile(r"\b" + e + r"\s*:\s*$", A)
+_GIVEN = re.compile(r"^\s*:\s*" + E + r"\s*,?\s*(\}\s*\))?", A)
+_QUOTED = re.compile(r"""["'`]""" + e + r"""["'`]""", A)
+_BY_NAME = re.compile(r"\." + e + r"\b|\b" + e + r"\s*\(", A)
+_CONSENT = re.compile(e + "Consent", re.IGNORECASE | A)
+_ENV = re.compile(r"process\.env|os\.environ|getenv", A)
+_REFLECTION = re.compile(
+    r"\bsetattr\s*\(|\bglobals\s*\(|\b__dict__\b|Object\.defineProperty|Reflect\.set", A
+)
+_GRANT_STARTS = re.compile(r"^\s*" + e + r"\s*:", A)
+_MODULE_THEN_GRANT = re.compile(r"^\s*import\.meta\.url\s*(?:,\s*(?:" + e + r"\s*:.*)?)?$", A)
+_CALLS = re.compile(r"\b" + CREATE + r"\s*\(", A)
+_OPENS = re.compile(r"\b" + CREATE + r"\s*\(\s*\{", A)
+#: Strings, left to right. A template literal keeps only its `${...}` code.
+_STRINGS = re.compile(
+    "|".join(
+        [
+            r"`(?:[^`\\]|\\.)*`",
+            r'(?<![fF])(?<![fF][rRbB])"(?:[^"\\]|\\.)*"',
+            r"(?<![fF])(?<![fF][rRbB])'(?:[^'\\]|\\.)*'",
+        ]
+    ),
+    A,
+)
+_ITEM = re.compile(r"^\s*(?:type\s+)?\w+(?:\s+as\s+\w+)?\s*,?\s*$", A)
+
+
+def grant_problems(source: str, python: bool = True) -> list[str]:
+    """Everything in `source` that could grant runtime egress; `python` for a `.py` file."""
+    problems: list[str] = []
+    if _SEPARATOR.search(source):
+        problems.append("a Unicode line separator (U+2028/U+2029)")
+    lines = _LINE_END.split(source)
+    marked = [line for line in lines if MARKER in line]
+    if len(marked) > 1:
+        problems.append(f"{len(marked)} lines carry the marker, not one")
+    declares = len(marked) == 1 and _OFF_LINE.search(marked[0]) is not None
+    codes = _code_lines(lines, python)
+
+    def next_code(i: int) -> str:
+        return next((c for c in codes[i + 1:] if c.strip() != ""), "")
+
+    def parens(text: str) -> int:
+        return text.count("(") - text.count(")")
+
+    # Parentheses still open in the runtime call, from its `(`; 0 outside it.
+    depth = 0
+    # Whether the open runtime call has named this file (module: import.meta.url).
+    call_module = False
+    # Open braces of the runtime call's options object, and whether it has closed.
+    braces = 0
+    obj_closed = False
+    for i, line in enumerate(lines):
+        at = f"line {i + 1}"
+        if MARKER in line:
+            if not _OFF_LINE.search(line):
+                problems.append(f'{at}: the marked line isn\'t a constant set to "off"')
+            continue
+        code = codes[i]
+        if code.strip() == "":
+            continue
+        if not python and "\\u" in code:
+            problems.append(f"{at}: a backslash-u escape in code")
+        if python and '"--module"' in line and not re.search(r"abspath\(__file__\)", code + next_code(i)):
+            problems.append(f"{at}: --module isn't this file (os.path.abspath(__file__))")
+        if _CALLS.search(code) and not _OPENS.search(code):
+            problems.append(f"{at}: {CREATE} not given an object literal")
+        opened = _OPENS.search(code)
+        start = 0 if depth > 0 else (opened.start() if opened else -1)
+        in_call = start >= 0
+        left = depth + parens(code[start:]) if in_call else 0
+        # Braces of the call's options object, before each character: `module` and
+        # the grant must sit at its top level, and its closing `}` must close the
+        # call, so no other object (a second argument, `|| {...}`) can stand in.
+        opened_call = None if depth > 0 else _OPENS.search(code)
+        obj_start = opened_call.end() - 1 if opened_call else 0
+        level: list[int] = []
+        b = braces if in_call else 0
+        for k, ch in enumerate(code):
+            level.append(b)
+            if not in_call or k < obj_start or obj_closed:
+                continue
+            if ch == "{":
+                b += 1
+            elif ch == "}":
+                b -= 1
+                if b == 0:
+                    obj_closed = True
+                    tail = code[k + 1:]
+                    if not re.match(r"\s*\)", tail) and not (tail.strip() == "" and re.match(r"\s*\)", next_code(i))):
+                        problems.append(f"{at}: the runtime's options object ends before its call does")
+        # `module: import.meta.url` must sit right before the grant: anything between
+        # (a spread, say) could replace it.
+        if in_call and (depth == 0 or not _GRANT_STARTS.match(code)):
+            call_module = False
+        for m in re.finditer(r"\bmodule\s*:(?!:)", code, A):
+            if not in_call:
+                continue
+            if level[m.start()] != 1:
+                problems.append(f"{at}: the runtime's module not at the top of its options object")
+                continue
+            rest = code[m.end():]
+            if not re.match(r"\s*import\.meta\.url\b", rest, A):
+                problems.append(f"{at}: the runtime's module given anything but import.meta.url")
+            else:
+                call_module = _MODULE_THEN_GRANT.match(rest) is not None
+        for m in _NAME.finditer(code):
+            before, after = code[: m.start()], code[m.end():]
+            allowed = (
+                re.match(r"\s*[!=]==?(?!=)", after)
+                or re.search(r"[!=]==?\s*$", before)
+                or _ONE_LINE_IMPORT.search(code)
+                or (re.search(r"\(\s*$", before) and re.match(r'\s*(?:\)|,\s*""\s*[,)])', after))
+                or (re.search(r"\w\.$", before, A) and not re.match(r"\s*[-+*/|&]?=(?!=)", after))
+                or _in_import_list(lines, i)
+                or _GIVEN_BEFORE.search(before)
+            )
+            if not allowed:
+                problems.append(f"{at}: {E} used other than as allowed")
+        for m in _WORD.finditer(code):
+            rest = code[m.end():]
+            if re.match(r"\s*[:=](?!=)", rest):
+                given = _GIVEN.match(rest)
+                tail = rest[given.end():] if given else rest
+                # Last in the call's object: the call closes right after it.
+                closes = (given is not None and given.group(1) is not None and left == 0) or (
+                    tail.strip() == "" and left == 1 and re.match(r"\s*\}\s*\)", next_code(i)) is not None
+                )
+                if not given or not closes or not in_call or level[m.start()] != 1:
+                    problems.append(f"{at}: the runtime given anything but {E}, last in {CREATE}({{...}})")
+                elif not call_module:
+                    problems.append(
+                        f"{at}: the runtime call doesn't name this file right before the grant (module: import.meta.url)"
+                    )
+                elif not declares:
+                    problems.append(f"{at}: the runtime given a {E} this file doesn't declare")
+            elif re.match(r"\s*[,})]", rest):
+                problems.append(f"{at}: the grant passed as a variable")
+        if _BY_NAME.search(code) or _QUOTED.search(line):
+            problems.append(f"{at}: the grant set by name")
+        if _CONSENT.search(line):
+            problems.append(f"{at}: a consent option")
+        if _REFLECTION.search(code):
+            problems.append(f"{at}: a binding set by reflection")
+        if _NAME.search(line) and _ENV.search(line):
+            problems.append(f"{at}: {E} read from the environment")
+        depth = max(left, 0)
+        braces = b if depth > 0 else 0
+        if depth == 0:
+            obj_closed = False
+    return problems
+
+
+def _code_lines(lines: list[str], python: bool) -> list[str]:
+    """Each line as code only: comments removed (block comments tracked across
+    lines in TS, docstrings in Python) and string contents blanked."""
+    out: list[str] = []
+    in_block = False
+    in_doc: Optional[str] = None
+    for raw in lines:
+        line = raw
+        if python:
+            if in_doc:
+                end = line.find(in_doc)
+                if end < 0:
+                    out.append("")
+                    continue
+                line = line[end + 3:]
+                in_doc = None
+            line = re.sub(r'("""|\'\'\')[\s\S]*?\1', '""', line)
+            opened = re.search(r'"""|\'\'\'', line)
+            if opened:
+                in_doc = opened.group(0)
+                line = line[: opened.start()]
+            line = _STRINGS.sub('""', line).replace(f"`{E}`", "")
+            out.append(re.sub(r"#.*$", "", line))
+            continue
+        if in_block:
+            end = line.find("*/")
+            if end < 0:
+                out.append("")
+                continue
+            line = line[end + 2:]
+            in_block = False
+
+        def blank(m: re.Match[str]) -> str:
+            s = m.group(0)
+            if s.startswith("`"):
+                return " " + " ".join(re.findall(r"\$\{([^}]*)\}", s)) + " "
+            return '""'
+
+        line = _STRINGS.sub(blank, line)
+        line = re.sub(r"/\*[\s\S]*?\*/", " ", line)
+        opened_at = line.find("/*")
+        if opened_at >= 0:
+            in_block = True
+            line = line[:opened_at]
+        out.append(re.sub(r"//.*$", "", line))
+    return out
+
+
+def _in_import_list(lines: list[str], i: int) -> bool:
+    """Is line `i` a bare item of a multi-line import (TS `import {...} from`, Python `from ... import (...)`)?"""
+
+    def strip(line: str) -> str:
+        return re.sub(r"\s*(?://|#).*$", "", line)
+
+    if not re.match(r"^\s*" + E + r"\s*,?\s*$", strip(lines[i]), A):
+        return False
+    start = i - 1
+    while start >= 0 and _ITEM.match(strip(lines[start])):
+        start -= 1
+    end = i + 1
+    while end < len(lines) and _ITEM.match(strip(lines[end])):
+        end += 1
+    open_ = strip(lines[start]) if start >= 0 else ""
+    close = strip(lines[end]) if end < len(lines) else ""
+    return bool(
+        (re.match(r"^\s*import\s*(?:type\s*)?(?:\w+\s*,\s*)?\{\s*$", open_, A) and re.match(r"^\s*\}\s*from\s", close, A))
+        or (re.match(r"^\s*from\s+[\w.]+\s+import\s*\(\s*$", open_, A) and re.match(r"^\s*\)\s*$", close, A))
+    )
diff --git a/system1/mapping.py b/system1/mapping.py
new file mode 100644
index 0000000..0eb3268
--- /dev/null
+++ b/system1/mapping.py
@@ -0,0 +1,19 @@
+"""The OpenAI filter's output in the `spam` answer space, generated by system1
+`adopt`. The shadow harness writes it as each captured row's `current`, so
+`decide compare` can set the filter's answer beside the decision model's.
+
+Strict, like `compare`'s own reading: anything but a boolean raises rather than
+being guessed into one.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+
+def to_answer_space(is_spam: bool) -> dict[str, Union[str, int, float]]:
+    """One value per question: a choice's key, a score's level, or a noul's 0-1."""
+    if not isinstance(is_spam, bool):
+        raise ValueError("is_spam is not a boolean")
+    # A yes/no mechanism is certain either way, so its noul is 1 or 0.
+    return {"spam": 1 if is_spam else 0}
diff --git a/system1/policy.py b/system1/policy.py
new file mode 100644
index 0000000..428ff8d
--- /dev/null
+++ b/system1/policy.py
@@ -0,0 +1,253 @@
+"""Decision-model policy for `spam`, generated by system1 `adopt` from
+`.system1/specs/spam.yaml` against `decide` runtime protocol 1. It stands in
+for spamfilter's OpenAI filter (`spamfilter.filters.openai.OpenAI.check`), one
+chat-model call parsed to `{is_spam: bool}`; `filter.py` wires it in as a filter.
+
+It sits in front of the existing mechanism and is inert until you switch it on
+twice: `enabled=True` where you call it, and the `EGRESS` line below. Until both
+are on, every call takes the existing path. Any call the model can't answer well
+enough also takes the existing path, with a reason code to log.
+
+Requirements, in the runtime image and in CI: Node 22 or later and the `decide`
+CLI on PATH (`npm install -g @garygentry/system1`). Every call starts one
+`decide` process, which costs its startup time (tens of milliseconds). The first
+call checks the runtime protocol; when `decide` is missing or speaks another
+protocol, every call takes the existing path with `engine-unavailable`.
+Python 3.9 or later.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import time
+from dataclasses import dataclass, field
+from typing import Any, Callable, Final, Literal, Optional
+
+# Runtime egress for this module. `adopt` writes "off" and never anything else.
+# Changing it to "on" is your decision, made in reviewed code: it lets this
+# module send the checked text to OpenRouter's decision model. Nothing else turns it on.
+EGRESS: Final = "off"  # system1: runtime egress (only you switch this on)
+
+#: Measured spend a UTC day before every call takes the existing path (`budget`).
+MAX_USD_PER_DAY: Final = 1.0
+#: The decision model this module was generated and recorded against.
+MODEL: Final = "typesafe/jev-1.13"
+#: The spec's name: the fixture namespace its recorded answers live under.
+SPEC: Final = "spam"
+#: The `decide runtime` stdin/stdout shape this module speaks.
+PROTOCOL: Final = 1
+#: The command that runs `decide`. Tests may point it elsewhere.
+DECIDE: list[str] = ["decide"]
+
+# The spec's questions, copied verbatim. Recorded answers are keyed on them,
+# so an edit here needs fresh fixtures (`decide spec check spam --live`).
+# test_policy.py checks they match the spec file.
+QUESTIONS: Final[dict[str, Any]] = {
+    "spam": {
+        "type": "noul",
+        "instructions": (
+            "The text is spam: unsolicited promotion or bait posted to reach an audience rather "
+            "than to take part in the conversation."
+        ),
+        "criteria": {
+            "true": (
+                "It advertises or asks people to visit, follow, subscribe to, buy or click something "
+                "(a channel, a profile, a site, a product, a giveaway, a money-making scheme), or it is "
+                "a scam, a chain message or a link dropped with no relevance."
+            ),
+            "false": (
+                "It is an ordinary reaction, opinion, question or joke about the topic at hand, even if "
+                "rude, off-topic, misspelled, in capitals or full of emoji, and even if it names a "
+                "well-known site or person in passing."
+            ),
+        },
+    },
+}
+
+# The spec's `policy.thresholds`. A `spam` answer between the two bars is not
+# acted on: the call takes the existing path.
+SPAM_AT_LEAST: Final = 0.7
+NOT_SPAM_AT_MOST: Final = 0.3
+
+
+def to_state(text: str) -> str:
+    """What the model sees for one text: the text itself, as the OpenAI filter
+    sends it. The shadow harness captures the same state, so `decide compare`
+    judges exactly what this module would send.
+    """
+    return text
+
+
+@dataclass
+class Outcome:
+    #: Whether the text is spam (the OpenAI filter's `is_spam`).
+    value: bool
+    #: "model" when the model's answer was used, "existing" otherwise.
+    by: Literal["model", "existing"]
+    #: Why the model's answer wasn't used: a runtime reason code, "disabled" or "below-threshold".
+    reason: Optional[str] = None
+    detail: str = ""
+    #: Each step of the decision, for a log line or a test.
+    trace: list[str] = field(default_factory=list)
+
+
+#: Runs `decide runtime` with the request on stdin and returns its parsed result.
+Engine = Callable[[dict[str, Any], "PolicyOptions"], dict[str, Any]]
+
+
+@dataclass(frozen=True)
+class PolicyOptions:
+    #: The app-level switch. False (the default) keeps the existing path for every call.
+    enabled: bool = False
+    #: Where the spend ledger and recorded answers live. A live call needs a writable one.
+    root: Optional[str] = None
+    #: True answers from `root`'s recorded fixtures and sends nothing: how the tests run.
+    replay: bool = False
+    timeout_ms: int = 5000
+    #: For tests: a stand-in for spawning `decide runtime`.
+    engine: Optional[Engine] = None
+
+
+def is_spam(
+    text: str,
+    existing: Callable[[str], bool],
+    options: PolicyOptions = PolicyOptions(),
+) -> Outcome:
+    """Whether `text` is spam, by the decision model, falling back to `existing`
+    when the policy is off or the model's answer doesn't clear the spec's
+    thresholds. It never raises because of the model; `existing` may.
+    """
+    trace: list[str] = []
+
+    def fall_back(reason: str, detail: str) -> Outcome:
+        trace.append(f"existing: {reason}")
+        return Outcome(existing(text), "existing", reason, detail, trace)
+
+    if not options.enabled:
+        return fall_back("disabled", "the policy is not enabled")
+    # `decide runtime` reads the grant from this file too; both must say on.
+    if not options.replay and EGRESS != "on":
+        return fall_back("egress-off", "runtime egress is off (this module's EGRESS line)")
+
+    request = {"questions": QUESTIONS, "state": to_state(text), "namespace": SPEC}
+    result = (options.engine or _spawn)(request, options)
+    if result.get("ok") is not True:
+        reason = result.get("reason")
+        reason = reason if isinstance(reason, str) else "internal"
+        trace.append(f"model: {reason}")
+        return fall_back(reason, str(result.get("detail", "")))
+    trace.append(f"model: {result.get('source')}")
+    value = from_answers(result.get("answers"), trace)
+    if value is None:
+        return fall_back("below-threshold", "; ".join(trace))
+    return Outcome(value, "model", trace=trace)
+
+
+def from_answers(answers: Any, trace: Optional[list[str]] = None) -> Optional[bool]:
+    """The model's answer as `is_spam`, or None when it sits between the bars.
+    The check is added to `trace`.
+    """
+    trace = trace if trace is not None else []
+    spam = answers.get("spam") if isinstance(answers, dict) else None
+    if not isinstance(spam, dict) or spam.get("type") != "noul":
+        trace.append("answers: spam missing or of the wrong type")
+        return None
+    noul = spam.get("noul")
+    verdict: Optional[bool] = None
+    if isinstance(noul, (int, float)) and not isinstance(noul, bool):
+        if noul >= SPAM_AT_LEAST:
+            verdict = True
+        elif noul <= NOT_SPAM_AT_MOST:
+            verdict = False
+    trace.append(f"spam: {noul} -> {'between the bars' if verdict is None else verdict}")
+    return verdict
+
+
+_protocol_checked: Optional[str] = None  # None: not settled yet; "": fine; otherwise why not
+
+
+def _engine_problem(timeout_s: float) -> str:
+    """Why `decide` can't serve this module, or "" when it can. A definite
+    answer (fine, missing, another protocol) is kept for the process; a
+    transient failure (a slow start, a failed fork) is tried again next call.
+    """
+    global _protocol_checked
+    if _protocol_checked is not None:
+        return _protocol_checked
+    try:
+        done = subprocess.run(
+            [*DECIDE, "runtime", "--protocol"],
+            capture_output=True,
+            encoding="utf-8",
+            timeout=timeout_s,
+            check=False,
+        )
+    except FileNotFoundError:
+        _protocol_checked = "decide is not on PATH (npm install -g @garygentry/system1)"
+        return _protocol_checked
+    except (OSError, subprocess.SubprocessError) as error:
+        return f"decide runtime --protocol failed ({type(error).__name__})"
+    try:
+        protocol = json.loads(done.stdout or "null")
+    except ValueError:
+        protocol = None
+    found = protocol.get("protocol") if isinstance(protocol, dict) else None
+    if found is None and isinstance(protocol, dict) and protocol.get("ok") is False:
+        # The CLI's error envelope: a `decide` from before `runtime` existed.
+        _protocol_checked = "decide has no runtime command (upgrade @garygentry/system1)"
+        return _protocol_checked
+    if found is None:
+        return f"decide runtime --protocol printed nothing usable (exit {done.returncode})"
+    _protocol_checked = "" if found == PROTOCOL else f"decide runtime speaks protocol {found}, not {PROTOCOL}"
+    return _protocol_checked
+
+
+def _spawn(request: dict[str, Any], options: PolicyOptions) -> dict[str, Any]:
+    """One `decide runtime` call. Every problem is a fallback, never an exception."""
+    # The call's own deadline, plus room to start Node, shared with the check.
+    deadline = time.monotonic() + options.timeout_ms / 1000 + 10
+    problem = _engine_problem(deadline - time.monotonic())
+    if problem:
+        return {"ok": False, "reason": "engine-unavailable", "detail": problem}
+    argv = [
+        *DECIDE,
+        "runtime",
+        "--module",
+        os.path.abspath(__file__),
+        "--max-usd-per-day",
+        str(MAX_USD_PER_DAY),
+        "--model",
+        MODEL,
+        "--timeout-ms",
+        str(options.timeout_ms),
+    ]
+    if options.root:
+        argv += ["--root", options.root]
+    if options.replay:
+        argv.append("--replay")
+    try:
+        done = subprocess.run(
+            argv,
+            input=json.dumps(request),
+            capture_output=True,
+            encoding="utf-8",
+            timeout=max(deadline - time.monotonic(), 0.001),
+            check=False,
+        )
+    except subprocess.TimeoutExpired:
+        return {"ok": False, "reason": "timeout", "detail": "decide runtime did not answer in time"}
+    except (OSError, subprocess.SubprocessError) as error:
+        return {"ok": False, "reason": "engine-unavailable", "detail": type(error).__name__}
+    try:
+        result = json.loads(done.stdout)
+    except ValueError:
+        return {
+            "ok": False,
+            "reason": "engine-unavailable",
+            "detail": f"decide runtime printed no result (exit {done.returncode})",
+        }
+    if not isinstance(result, dict):
+        return {"ok": False, "reason": "engine-unavailable", "detail": "decide runtime printed no result"}
+    return result
