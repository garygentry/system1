diff --git a/.system1/specs/spam.yaml b/.system1/specs/spam.yaml
new file mode 100644
index 0000000..ba6ad85
--- /dev/null
+++ b/.system1/specs/spam.yaml
@@ -0,0 +1,46 @@
+description: >-
+  Whether a user-submitted text (a comment, a chat message) is spam, the judgement
+  spamfilter's OpenAI filter makes with one chat-model call (filters/openai.py, OpenAI.check).
+questions:
+  spam:
+    type: noul
+    instructions: >-
+      The text is spam: unsolicited promotion or bait posted to reach an audience rather than
+      to take part in the conversation.
+    criteria:
+      true: >-
+        It advertises or asks people to visit, follow, subscribe to, buy or click something
+        (a channel, a profile, a site, a product, a giveaway, a money-making scheme), or it is
+        a scam, a chain message or a link dropped with no relevance.
+      false: >-
+        It is an ordinary reaction, opinion, question or joke about the topic at hand, even if
+        rude, off-topic, misspelled, in capitals or full of emoji, and even if it names a
+        well-known site or person in passing.
+keep: ["spam>=0.7"]
+policy:
+  thresholds:
+    spam:
+      value: 0.7
+      why: >-
+        A text called spam is blocked, so a wrong block silences a real user, while a missed
+        spam stays visible until a moderator acts. A wrong block costs more, so blocking needs
+        a confident yes. At or below 0.3 the module lets the text through; between the bars it
+        keeps the existing filter's answer.
+examples:
+  - id: channel-plug
+    state: "Hey everyone, check out my channel, I make covers of this song!! Subscribe pls"
+    expect: { spam: true }
+  - id: money-scheme
+    state: "I make $500 a day working from home, go to www.easy-cash-now.example and see how"
+    expect: { spam: true }
+  - id: reaction
+    state: "This song never gets old, still listening in 2015"
+    expect: { spam: false }
+  - id: rude-not-spam
+    state: "WORST VIDEO EVER, WHO EVEN LIKES THIS"
+    expect: { spam: false }
+  - id: names-a-site-in-passing
+    state: "I first heard this on the radio, then found it on YouTube the same night"
+    expect: { spam: false }
+  - id: like-bait
+    state: "Like this comment if you are watching in 2014!"
diff --git a/system1/capture.py b/system1/capture.py
new file mode 100644
index 0000000..4361eb8
--- /dev/null
+++ b/system1/capture.py
@@ -0,0 +1,107 @@
+"""Runs the shadow harness for `spam` over a seeded sample of the UCI YouTube
+Spam Collection, and writes its labels:
+
+    PYTHONPATH=src:system1 python system1/capture.py <dir with Youtube0*.csv> [N]
+
+- `.system1/compare/spam/captured.jsonl`: one row per comment, with the OpenAI
+  filter's verdict (openai/gpt-4o-mini through OpenRouter) as `current`. This
+  runs the existing mechanism for real: each row is a paid call that sends the
+  comment to OpenRouter, outside system1's checks.
+- `.system1/labels/spam.jsonl`: the corpus's own `CLASS` (1 spam, 0 not).
+
+The harness asks OpenRouter to report each call's cost (`usage.include`), an
+accounting flag that leaves the request's content and the answer as they are.
+A row whose cost isn't reported has no `usage`: unknown, never zero.
+Ids are `<file>:<COMMENT_ID>`, so a rerun skips the same comments, never others.
+"""
+
+from __future__ import annotations
+
+import csv
+import glob
+import json
+import os
+import random
+import sys
+from typing import Any
+
+from shadow import CAPTURE_FILE, CurrentRun, capture_shadow
+from spamfilter.filters import OpenAI
+
+SEED = 20261006
+MODEL = "openai/gpt-4o-mini"
+
+
+def corpus(directory: str) -> list[tuple[str, str, int]]:
+    rows: list[tuple[str, str, int]] = []
+    for path in sorted(glob.glob(os.path.join(directory, "Youtube0*.csv"))):
+        stem = os.path.basename(path).split("-")[0]
+        with open(path, encoding="utf-8", newline="") as f:
+            for row in csv.DictReader(f):
+                rows.append((f"{stem}:{row['COMMENT_ID']}", row["CONTENT"], int(row["CLASS"])))
+    return rows
+
+
+def sample(rows: list[tuple[str, str, int]], n: int) -> list[tuple[str, str, int]]:
+    """n rows, half from each class, drawn with a fixed seed."""
+    rng = random.Random(SEED)
+    spam = [r for r in rows if r[2] == 1]
+    ham = [r for r in rows if r[2] == 0]
+    picked = rng.sample(spam, n // 2) + rng.sample(ham, n - n // 2)
+    rng.shuffle(picked)
+    return picked
+
+
+def existing_filter() -> tuple[OpenAI, dict[str, Any]]:
+    """The OpenAI filter as a user would configure it, plus the last response's usage."""
+    f = OpenAI(
+        MODEL,
+        base_url="https://openrouter.ai/api/v1",
+        api_key=os.environ["OPENROUTER_API_KEY"],
+        timeout=30,
+    )
+    last: dict[str, Any] = {}
+    create = f._client.chat.completions.create  # pylint: disable=protected-access
+
+    def recording_create(**kwargs: Any) -> Any:
+        last.clear()
+        response = create(**kwargs, extra_body={"usage": {"include": True}})
+        usage = getattr(response, "usage", None)
+        if usage is not None:
+            last.update(
+                cost=getattr(usage, "cost", None),
+                input_tokens=getattr(usage, "prompt_tokens", None),
+                output_tokens=getattr(usage, "completion_tokens", None),
+            )
+        return response
+
+    f._client.chat.completions.create = recording_create  # type: ignore[method-assign]
+    return f, last
+
+
+def main() -> None:
+    directory = sys.argv[1]
+    n = int(sys.argv[2]) if len(sys.argv) > 2 else 200
+    picked = sample(corpus(directory), n)
+    f, last = existing_filter()
+
+    def current(text: str) -> CurrentRun:
+        passed, _ = f.check(text)
+        return CurrentRun(output=not passed, usage=dict(last) or None)
+
+    summary = capture_shadow([(i, text) for i, text, _ in picked], current)
+    labels = os.path.join(".system1", "labels", "spam.jsonl")
+    os.makedirs(os.path.dirname(labels), exist_ok=True)
+    with open(labels, "w", encoding="utf-8") as out:
+        for i, _, label in picked:
+            out.write(json.dumps({"id": i, "labels": {"spam": label}}) + "\n")
+    print(
+        f"captured {summary.written} (skipped {len(summary.skipped)}, failed {len(summary.failed)})"
+        f" -> {CAPTURE_FILE}; {len(picked)} labels -> {labels}"
+    )
+    for i, error in summary.failed[:5]:
+        print(f"  failed {i}: {error}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/system1/evaluate.py b/system1/evaluate.py
new file mode 100644
index 0000000..6258556
--- /dev/null
+++ b/system1/evaluate.py
@@ -0,0 +1,60 @@
+"""Scores the `spam` policy as it would run, the two bars and the fallback to
+the OpenAI filter included, against the corpus labels:
+
+    PYTHONPATH=src:system1 python system1/evaluate.py
+
+It replays the answers `decide compare spam --record` kept in
+`.system1/compare/spam/fixtures/` through `decide runtime --replay`, and the
+OpenAI filter's answers from the capture, so it sends nothing and needs no key.
+`DECIDE_CMD` names another `decide`, as in the tests.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shlex
+import time
+from collections import Counter
+
+import policy
+from policy import PolicyOptions, is_spam
+
+if os.environ.get("DECIDE_CMD"):
+    policy.DECIDE = shlex.split(os.environ["DECIDE_CMD"])
+
+ROOT = os.path.join(".system1", "compare", "spam")
+rows = [json.loads(line) for line in open(os.path.join(ROOT, "captured.jsonl"), encoding="utf-8")]
+labels = {
+    r["id"]: r["labels"]["spam"]
+    for r in map(json.loads, open(os.path.join(".system1", "labels", "spam.jsonl"), encoding="utf-8"))
+}
+options = PolicyOptions(enabled=True, replay=True, root=ROOT)
+tally: Counter[str] = Counter()
+fallbacks: Counter[str] = Counter()
+confusion = {"existing": Counter(), "policy": Counter()}
+spawn_ms: list[float] = []
+both_right = Counter()
+for row in rows:
+    truth = labels[row["id"]] == 1
+    current = row["current"]["spam"] == 1
+    started = time.perf_counter()
+    outcome = is_spam(row["state"], lambda _t, c=current: c, options)
+    # The module's own path in replay: one `decide runtime` spawn, no network.
+    spawn_ms.append((time.perf_counter() - started) * 1000)
+    if outcome.by == "model":
+        tally["model"] += 1
+    else:
+        fallbacks[outcome.reason or "?"] += 1
+    both_right[(current == truth, outcome.value == truth)] += 1
+    for side, said in (("existing", current), ("policy", outcome.value)):
+        tally[side] += said == truth
+        confusion[side][("tp" if truth else "fp") if said else ("fn" if truth else "tn")] += 1
+n = len(rows)
+print(f"n={n}  existing {tally['existing']}/{n}  policy {tally['policy']}/{n}  model decided {tally['model']}")
+print("fell back:", dict(fallbacks))
+for side, c in confusion.items():
+    print(f"{side}: tp {c['tp']} fp {c['fp']} fn {c['fn']} tn {c['tn']}")
+spawn_ms.sort()
+print(f"replay call through decide runtime: p50 {spawn_ms[n // 2]:.0f} ms, p95 {spawn_ms[int(n * 0.95)]:.0f} ms (n={n})")
+print(f"discordant: policy right, filter wrong {both_right[(False, True)]}; filter right, policy wrong {both_right[(True, False)]}")
